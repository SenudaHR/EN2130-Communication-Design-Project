      )\n        self.resize(900, 650)\n        self.bg_image_path = bg_image\n  \
      \      \n        # --- STATE FLAGS ---\n        self.is_waiting_for_ack = False\
      \ \n        \n        # --- DATA STRUCTURES ---\n        self.added_addresses\
      \ = set()\n        self.selected_btn = None \n        self.current_dest_address\
      \ = None\n        self.user_layouts = {}\n        self.contact_buttons = []\n\
