      \       self.send_btn = QtWidgets.QPushButton(\"Send\")\n        self.send_btn.setCursor(QtCore.Qt.PointingHandCursor)\n\
      \        self.send_btn.setStyleSheet(\"\"\"\n            QPushButton { background-color:\
