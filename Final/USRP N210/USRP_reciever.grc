- name: epy_block_2_0_0
  id: epy_block
  parameters:
    _source_code: "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\nimport threading\n\
      import pmt\nimport time\nimport os\nfrom gnuradio import gr\n\nclass pdu_text_gui_saw_safe(gr.basic_block):\n\
      \    \"\"\"\n    Stop-and-Wait ARQ with Sync Burst, optimized for USRP to avoid\
      \ overflow errors.\n    \"\"\"\n\n    def __init__(self, wait_time=2.0, address=0x01,\n\
      \                 retry_limit=100, sync_bits=1000,\n                 max_chunk_size=1024):\n\
      \n        gr.basic_block.__init__(\n            self,\n            name=\"Safe\
      \ GUI Text to Single PDU with Stop-and-Wait ARQ\",\n            in_sig=[],\n\
      \            out_sig=[]\n        )\n\n        # Parameters\n        self._timeout\
      \ = float(wait_time)\n        self._address = int(address) & 0xFF\n        self._retry_limit\
      \ = int(retry_limit)\n        self._sync_bits = int(sync_bits)\n        self._max_chunk_size\
      \ = int(max_chunk_size)\n\n        # Sequence/ACK\n        self._seq_id = 1\n\
