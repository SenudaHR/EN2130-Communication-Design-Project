      \ = threading.Event()\n        self._lock = threading.Lock()\n\n        # Buffers\n\
      \        self._text_data = b\"\"\n        self._single_packet = None\n     \
      \   self._attempts = 0\n\n    # ----------------------------\n    # Sync Burst\n\
      \    # ----------------------------\n    def _send_sync_burst(self):\n     \
      \   if self._sync_bits <= 0:\n            return\n        sync_data = os.urandom(self._sync_bits)\n\
      \        vec = pmt.init_u8vector(len(sync_data), list(sync_data))\n        pdu\
      \ = pmt.cons(pmt.PMT_NIL, vec)\n        self.message_port_pub(pmt.intern(\"\
      out\"), pdu)\n        print(f\"[SAFE] Sync Burst sent ({len(sync_data)} bytes)\"\
      )\n\n    # ----------------------------\n    # Text input\n    # ----------------------------\n\
      \    def _process_text(self, msg):\n        try:\n            if pmt.is_symbol(msg):\n\
      \                text_str = pmt.symbol_to_string(msg)\n            elif pmt.is_string(msg):\n\
      \                text_str = pmt.string_to_string(msg)\n            else:\n \
      \               print(\"[SAFE] Invalid PMT format\")\n                return\n\
      \n            self._text_data = text_str.encode(\"utf-8\")\n\n            if\
      \ self._thread is None or not self._thread.is_alive():\n                self._stop_event.clear()\n\
      \                self._thread = threading.Thread(target=self._run)\n       \
      \         self._thread.daemon = True\n                self._thread.start()\n\
      \n        except Exception as e:\n            print(f\"[SAFE] Error processing\
      \ text: {e}\")\n\n    # ----------------------------\n    # Main ARQ loop\n\
      \    # ----------------------------\n    def _run(self):\n        raw = self._text_data\n\
      \        current_seq = self._seq_id\n        print(f\"[SAFE] Starting TX at\
      \ seq=0x{current_seq:02X}\")\n\n        packet = bytes([self._address, current_seq])\
      \ + raw\n        self._single_packet = (current_seq, packet)\n        self._attempts\
      \ = 0\n        acked = False\n\n        while not acked and not self._stop_event.is_set():\n\
      \            # 1\uFE0F\u20E3 Send Sync Burst first\n            if self._attempts\
      \ > 0:\n                self._send_sync_burst()\n\n            # 2\uFE0F\u20E3\
      \ Send packet in chunks to prevent overflow\n            seq_id, pkt = self._single_packet\n\
      \            total_len = len(pkt)\n            offset = 0\n\n            while\
      \ offset < total_len:\n                chunk = pkt[offset:offset + self._max_chunk_size]\n\
      \                vec = pmt.init_u8vector(len(chunk), list(chunk))\n        \
      \        pdu = pmt.cons(pmt.PMT_NIL, vec)\n                self.message_port_pub(pmt.intern(\"\
      out\"), pdu)\n                offset += self._max_chunk_size\n             \
      \   time.sleep(self._timeout / 10)  # small non-blocking sleep\n\n         \
      \   print(f\"[SAFE] Sent PDU id=0x{seq_id:02X} (Attempt {self._attempts + 1})\"\
      )\n\n            # 3\uFE0F\u20E3 Wait for ACK\n            waited = 0.0\n  \
      \          interval = 0.05\n            while waited < self._timeout:\n    \
      \            if self._last_ack_seq == seq_id:\n                    acked = True\n\
      \                    break\n                time.sleep(interval)\n         \
      \       waited += interval\n\n            if not acked:\n                self._attempts\
      \ += 1\n                if self._attempts >= self._retry_limit:\n          \
      \          print(f\"[SAFE] Retry limit reached for 0x{seq_id:02X}\")\n     \
      \               self.message_port_pub(pmt.intern(\"feedback\"),\n          \
      \                                pmt.intern(\"RETRY_LIMIT_EXCEEDED\"))\n   \
      \                 self._seq_id = (self._seq_id + 1) & 0xFF\n               \
      \     break\n                print(f\"[SAFE] Timeout for 0x{seq_id:02X} \u2192\
      \ Retransmit\")\n            else:\n                print(f\"[SAFE] PDU id=0x{seq_id:02X}\
      \ ACKed\")\n                self.message_port_pub(pmt.intern(\"feedback\"),\
      \ pmt.intern(\"END_ACK_RECEIVED\"))\n                self._single_packet = None\n\
      \                self._attempts = 0\n                self._seq_id = (self._seq_id\
      \ + 1) & 0xFF\n\n    # ----------------------------\n    # ACK handler\n   \
      \ # ----------------------------\n    def _process_ack(self, msg):\n       \
      \ try:\n            payload = pmt.cdr(msg)\n            if not pmt.is_u8vector(payload):\n\
      \                return\n            arr = bytearray(pmt.u8vector_elements(payload))\n\
      \            if len(arr) < 2 or arr[0] != 0xAA:\n                return\n  \
      \          ack_id = arr[1]\n\n            with self._lock:\n               \
      \ if self._single_packet is None:\n                    return\n            \
      \    if ack_id == self._single_packet[0]:\n                    self._last_ack_seq\
      \ = ack_id\n                    self._attempts = 0\n                    print(f\"\
      [SAFE] ACK received for 0x{ack_id:02X}\")\n\n        except Exception as e:\n\
      \            print(f\"[SAFE] ACK error: {e}\")\n\n"
