- name: epy_block_4_0_0_0
  id: epy_block
  parameters:
    _source_code: "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\nimport pmt\n\
      import zlib\nimport time\nimport os\nfrom gnuradio import gr\n\nclass crc_forwarder_unorder(gr.basic_block):\n\
      \    \"\"\"\n    CRC32 Checker + Unordered Forwarder\n    - Input : [sender_addr\
      \ | seq_id | payload | crc32]\n    - Output: [sender_addr | payload] (Forwarded\
      \ IMMEDIATELY and UNORDERED)\n    - ACKs all packets with valid CRC.\n    \"\
      \"\"\n\n    def __init__(self, retry_limit=1, ack_batch_size=5, sync_len=1000):\n\
      \        gr.basic_block.__init__(\n            self,\n            name=\"CRC32\
      \ Unordered Forwarder\",\n            in_sig=[],\n            out_sig=[]\n \
      \       )\n\n        self.retry_limit = max(1, int(retry_limit))\n        self.ack_batch_size\
      \ = max(1, int(ack_batch_size))\n        self.sync_len = int(sync_len)  # Number\
      \ of sync bytes\n        \n        # We no longer need the full buffer or expected_seq\
      \ for forwarding.\n        # We only keep received_ids for simple packet deduplication\
      \ within a recent window.\n        self.ack_queue = []\n        # Stores every\
      \ received ID for deduplication: {sender_addr: set(seq_ids)}\n        self.received_ids\
      \ = {} \n        # Stores the highest seen sequence ID for each sender to manage\
      \ the deduplication window\n        self.highest_seq = {} \n\n        # Ports\n\
      \        self.message_port_register_in(pmt.intern(\"in\"))\n        self.message_port_register_out(pmt.intern(\"\
      out\"))\n        self.message_port_register_out(pmt.intern(\"ack_out\"))\n\n\
      \        self.set_msg_handler(pmt.intern(\"in\"), self._handle_msg)\n\n    \
      \    print(f\"[CRC32] Receiver init (retries={self.retry_limit}, batch={self.ack_batch_size},\
      \ sync_len={self.sync_len})\")\n\n    def _flush_ack_queue(self):\n        \"\
      \"\"Sends sync bytes (if any), then flushes all queued ACKs.\"\"\"\n       \
      \ if not self.ack_queue:\n            return\n\n        print(f\"[ACK] Batch\
      \ threshold reached. Flushing {len(self.ack_queue)} ACKs...\")\n\n        #\
      \ 1. Send Synchronization/Wake-up Bytes (if configured)\n        if self.sync_len\
      \ > 0:\n            noise_data = os.urandom(self.sync_len)\n            noise_vec\
      \ = pmt.init_u8vector(len(noise_data), list(noise_data))\n            noise_pdu\
      \ = pmt.cons(pmt.PMT_NIL, noise_vec)\n            self.message_port_pub(pmt.intern(\"\
      ack_out\"), noise_pdu)\n            time.sleep(0.01)  \n\n        # 2. Send\
      \ all queued ACKs\n        for ack_pdu in self.ack_queue:\n            for i\
      \ in range(self.retry_limit):\n                self.message_port_pub(pmt.intern(\"\
      ack_out\"), ack_pdu)\n                time.sleep(0.005)  \n        \n      \
      \  # Clear the queue\n        self.ack_queue = []\n        print(\"[ACK] Batch\
      \ flush complete.\")\n    \n    def _clean_dedup_set(self, addr, pkt_id):\n\
      \        \"\"\"Keeps the received_ids set from growing indefinitely by only\
      \ tracking IDs near the highest seen ID.\"\"\"\n        if addr not in self.received_ids:\n\
      \            self.received_ids[addr] = set()\n            self.highest_seq[addr]\
      \ = pkt_id\n            return\n\n        current_highest = self.highest_seq[addr]\n\
      \        \n        # Check if the new ID is significantly greater than the current\
      \ highest, indicating a wrap or large jump\n        if (pkt_id > current_highest)\
      \ and (pkt_id - current_highest < 128):\n            self.highest_seq[addr]\
      \ = pkt_id\n        # Handle 8-bit wrap around (e.g., 255 -> 1)\n        elif\
      \ (current_highest > 128) and (pkt_id < 128) and (current_highest - pkt_id >\
      \ 128):\n            self.highest_seq[addr] = pkt_id\n\n        # Simple cleanup:\
      \ clear IDs that are 128 behind the current highest (assuming 8-bit ID range\
      \ 1-255)\n        # We use a window of about 128 to ensure we catch most duplicates\
      \ while freeing up old IDs.\n        old_cutoff = (self.highest_seq[addr] -\
      \ 128) & 0xFF\n        \n        ids_to_remove = []\n        for seq_id in self.received_ids[addr]:\n\
      \            # This is a robust check for checking if seq_id is older than old_cutoff,\
      \ considering wrap-around\n            if (seq_id != old_cutoff) and (((seq_id\
      \ - old_cutoff) & 0xFF) < 128):\n                ids_to_remove.append(seq_id)\n\
      \n        for seq_id in ids_to_remove:\n            self.received_ids[addr].discard(seq_id)\n\
      \n    def _handle_msg(self, msg):\n        if not pmt.is_pair(msg):\n      \
      \      return\n        vec = pmt.cdr(msg)\n        if not pmt.is_u8vector(vec):\n\
      \            return\n\n        data = bytearray(pmt.u8vector_elements(vec))\n\
      \        if len(data) < 6:\n            print(\"[CRC32] Frame too short\")\n\
      \            return\n\n        sender_addr = data[0]\n        pkt_id = data[1]\n\
      \        payload = data[2:-4]\n        recv_crc = int.from_bytes(data[-4:],\
      \ \"big\")\n\n        # CRC check\n        calc_crc = zlib.crc32(bytes([sender_addr,\
      \ pkt_id]) + payload) & 0xFFFFFFFF\n        if calc_crc != recv_crc:\n     \
      \       print(f\"[CRC32] FAIL (Addr=0x{sender_addr:02X}, ID=0x{pkt_id:02X})\"\
      )\n            return\n\n        print(f\"[CRC32] OK (Addr=0x{sender_addr:02X},\
      \ ID=0x{pkt_id:02X})\")\n        \n        # Initialize state for new sender\
      \ address\n        if sender_addr not in self.received_ids:\n            self.received_ids[sender_addr]\
      \ = set()\n            self.highest_seq[sender_addr] = 0\n            \n   \
      \     # --- Build ACK & Queue It (ACK always sent if CRC passes) ---\n     \
      \   ack_data = bytearray([sender_addr, 0xAA, pkt_id])\n        ack_crc = zlib.crc32(ack_data)\
      \ & 0xFFFFFFFF\n        ack_data += ack_crc.to_bytes(4, 'big')\n\n        ack_vec\
      \ = pmt.init_u8vector(len(ack_data), list(ack_data))\n        ack_pdu = pmt.cons(pmt.PMT_NIL,\
      \ ack_vec)\n\n        self.ack_queue.append(ack_pdu)\n        print(f\"[ACK]\
      \ Queued ({len(self.ack_queue)}/{self.ack_batch_size})\")\n\n        # Check\
      \ threshold\n        if len(self.ack_queue) >= self.ack_batch_size:\n      \
      \      self._flush_ack_queue()\n\n        # Dedup Check\n        if pkt_id in\
      \ self.received_ids[sender_addr]:\n            print(f\"[Forward] Duplicate\
      \ packet ID=0x{pkt_id:02X}, ignored payload\")\n            return\n\n     \
      \   # Mark as received\n        self.received_ids[sender_addr].add(pkt_id)\n\
      \        \n        # Clean up old entries in the dedup set\n        self._clean_dedup_set(sender_addr,\
      \ pkt_id)\n\n        # --- IMMEDIATE UNORDERED FORWARDING (New Requirement)\
      \ ---\n        full_payload_segment = payload\n        forward_bytes = bytes([sender_addr])\
      \ + full_payload_segment\n\n        out_vec = pmt.init_u8vector(len(forward_bytes),\
      \ list(forward_bytes))\n        out_msg = pmt.cons(pmt.PMT_NIL, out_vec)\n \
      \       self.message_port_pub(pmt.intern(\"out\"), out_msg)\n\n        print(f\"\
      [Forward] Packet forwarded immediately (ID=0x{pkt_id:02X}, {len(full_payload_segment)}\
      \ bytes).\")\n"
    ack_batch_size: '1'
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    retry_limit: '2'
    sync_len: '1000'
  states:
    _io_cache: '(''CRC32 Unordered Forwarder'', ''crc_forwarder_unorder'', [(''retry_limit'',
      ''1''), (''ack_batch_size'', ''5''), (''sync_len'', ''1000'')], [(''in'', ''message'',
      1)], [(''ack_out'', ''message'', 1), (''out'', ''message'', 1)], ''\n    CRC32
      Checker + Unordered Forwarder\n    - Input : [sender_addr | seq_id | payload
      | crc32]\n    - Output: [sender_addr | payload] (Forwarded IMMEDIATELY and UNORDERED)\n    -
      ACKs all packets with valid CRC.\n    '', [''ack_batch_size'', ''retry_limit'',
      ''sync_len''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 1200.0]
    rotation: 0
    state: enabled
- name: epy_block_5_0
  id: epy_block
  parameters:
    _source_code: "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\nimport pmt\nfrom\
      \ gnuradio import gr\nfrom Crypto.Cipher import AES\nfrom Crypto.Util.Padding\
      \ import pad\n\nclass aes_encrypt(gr.basic_block):\n    \"\"\"\n    AES Encryption\
      \ Block\n    - Encrypts PDUs using AES-128-CBC\n    - Key & IV fixed for demo\
      \ (replace with secure exchange in real systems)\n    \"\"\"\n\n    def __init__(self,\
      \ key=b\"1234567890abcdef\", iv=b\"abcdef1234567890\"):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"AES Encrypt\",\n            in_sig=[],\n\
      \            out_sig=[]\n        )\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.message_port_register_out(pmt.intern(\"out\"))\n      \
      \  self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n        self.key\
      \ = key\n        self.iv = iv\n\n    def handle_msg(self, msg_pmt):\n      \
      \  if pmt.is_pair(msg_pmt):\n            meta = pmt.car(msg_pmt)\n         \
      \   data = bytes(pmt.u8vector_elements(pmt.cdr(msg_pmt)))\n\n            cipher\
      \ = AES.new(self.key, AES.MODE_CBC, self.iv)\n            enc_data = cipher.encrypt(pad(data,\
      \ AES.block_size))\n\n            out_pmt = pmt.cons(meta, pmt.init_u8vector(len(enc_data),\
      \ list(enc_data)))\n            self.message_port_pub(pmt.intern(\"out\"), out_pmt)\n"
    affinity: ''
    alias: ''
    comment: ''
    iv: b"abcdef1234567890"
    key: b"1234567890abcd30"
    maxoutbuf: '0'
    minoutbuf: '0'
